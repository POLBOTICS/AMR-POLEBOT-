<?xml version="1.0" ?>
<sdf version="1.8" xmlns:xacro="http://ros.org/wiki/xacro">
  <model name='polebot_amr' canonical_link='base_link'>

    <xacro:property name="XACRO_DIR" value="${xacro.abs_filename('')}" />

    <!-- mapping_mode=true → hapus collision monitor agar LiDAR scan bersih.
         Dideklarasikan di awal karena dipakai di monitor_link (sebelum trolley). -->
    <xacro:arg name="mapping_mode" default="false"/>

    <!-- hitch_type: 'revolute' (Pivot, trailer berartikulasi) atau 'fixed'
         (Fixed tow, trailer terkunci kaku). Dipakai di trolley_hitch_joint. -->
    <xacro:arg name="hitch_type" default="revolute"/>
    <xacro:property name="hitch_type_val" value="$(arg hitch_type)"/>

    <!-- Define robot constants -->
    <xacro:property name="base_mass" value="84.837"/>
    <xacro:property name="base_width" value="0.670"/>
    <xacro:property name="base_length" value="1.172"/>
    <xacro:property name="base_height" value="0.563"/>
    
    <xacro:property name="monitor_mass" value="16.008"/>
    <xacro:property name="monitor_width" value="0.1"/>
    <xacro:property name="monitor_length" value="0.1"/>
    <xacro:property name="monitor_height" value="0.9"/>
    <xacro:property name="monitor_zoff" value="0.730"/>
    <xacro:property name="monitor_xoff" value="0.204"/>    

    <xacro:property name="wheel_mass" value="3.610"/>
    <xacro:property name="wheel_radius" value="0.079"/>
    <xacro:property name="wheel_width" value="0.055"/>
    <xacro:property name="wheel_xoff" value="0.000"/>
    <xacro:property name="wheel_yoff" value="0.300"/>
    <xacro:property name="wheel_separation" value="0.600"/> <!-- 2 * abs(wheel_yoff) -->
    <xacro:property name="wheel_zoff" value="0.231"/>

    <xacro:property name="caster_mass" value="1.355"/>
    <xacro:property name="caster_radius" value="0.0625"/>
    <xacro:property name="caster_width" value="0.0520"/>    
    <xacro:property name="caster_xoff" value="0.300"/> <!-- 0.356 -->
    <xacro:property name="caster_yoff" value="-0.0289"/>
    <xacro:property name="caster_zoff" value="0.245"/>   

    <xacro:property name="imu_mass" value="0.1"/>
    <xacro:property name="imu_xoff" value="0.1"/>
    <xacro:property name="imu_zoff" value="0.1"/>

    <xacro:property name="lidar_mass" value="0.314"/>
    <xacro:property name="lidar_xoff" value="0.496"/>
    <xacro:property name="lidar_zoff" value="0.040"/>

    <xacro:property name="camera_mass" value="0.123"/>
    <xacro:property name="camera_xoff" value="0.560"/>
    <xacro:property name="camera_zoff" value="-0.023"/>

    <!-- Define some commonly used inertial properties  -->
    <xacro:macro name="box_inertia" params="m w l h">
      <inertial>
        <pose>0 0 0 ${pi/2} 0 ${pi/2}</pose>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(m/12) * (l*l + h*h)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(m/12) * (w*w + h*h)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(m/12) * (w*w + l*l)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r h">
      <inertial>
        <pose>0 0 0 ${pi/2} 0 0</pose>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(m/12) * (3*r*r + h*h)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(m/12) * (3*r*r + h*h)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(m/2) * (r*r)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r">
      <inertial>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(2/5) * m * (r*r)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(2/5) * m * (r*r)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(2/5) * m * (r*r)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>

    <!-- Robot Base -->
    <link name='base_link'>
      <must_be_base_link>true</must_be_base_link>
      <visual name="base_link_visual">
        <pose relative_to="base_link">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file://${XACRO_DIR}/meshes/polebot_amr.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0.4 0.5 1</ambient>
          <diffuse>0 0.4 0.5 1</diffuse>
        </material>
      </visual>

      <collision name="base_link_collision">
        <geometry>
          <box><size>
            ${base_length} ${base_width} ${base_height/2}
          </size></box>
        </geometry>
      </collision>
    </link>

    <!-- Robot Footprint -->
    <joint name='base_joint' type='fixed'>
      <parent>base_link</parent>
      <child>base_footprint</child>
      <pose relative_to="base_link">0.0 0.0 ${-(wheel_radius+wheel_zoff)} 0 0 0</pose>
    </joint>
    
    <link name='base_footprint'>
      <pose relative_to="base_joint"/>
      <xacro:box_inertia m="${base_mass}" w="${base_width}" l="${base_length}" h="${base_height}"/>
    </link>

    <!-- Display Monitor -->
    <joint name='monitor_joint' type='fixed'>
      <parent>base_link</parent>
      <child>monitor_link</child>
      <pose relative_to="base_link">${monitor_xoff} 0 ${monitor_zoff} 0 0 0</pose>
    </joint>

    <link name='monitor_link'>
      <pose relative_to="monitor_joint"/>
      <visual name="monitor_link_visual">
        <geometry>
          <mesh>
            <uri>file://${XACRO_DIR}/meshes/monitor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <xacro:unless value="$(arg mapping_mode)">
      <collision name="monitor_link_collision">
        <geometry>
          <box><size>
            ${monitor_length} ${monitor_width} ${monitor_height}
          </size></box>
        </geometry>
      </collision>
      </xacro:unless>
      <xacro:box_inertia m="${monitor_mass}" w="${monitor_width}" l="${monitor_length}" h="${monitor_height}"/>
    </link>   

    <!-- Wheels -->
    <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
      <joint name="${prefix}_joint" type="revolute">
        <parent>base_link</parent>
        <child>${prefix}_link</child>
        <pose relative_to="base_link">${x_reflect*wheel_xoff} ${y_reflect*wheel_yoff} ${-wheel_zoff} 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-inf</lower>
            <upper>inf</upper>
          </limit>
          <dynamics>
            <damping>0.02</damping>
          </dynamics>
        </axis>
      </joint>

      <link name="${prefix}_link">
        <pose relative_to="${prefix}_joint"/>
        <visual name="${prefix}_link_visual">
          <pose relative_to="${prefix}_link">0 0 0 0 0 ${(y_reflect-1)*pi/2}</pose>
          <geometry>
            <mesh>
              <uri>file://${XACRO_DIR}/meshes/wheel.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
          </material>
        </visual>

        <collision name="${prefix}_link_collision">
          <pose relative_to="${prefix}_link">0 0 0 ${pi/2} 0 0</pose>
          <geometry>
            <cylinder>
              <radius>${wheel_radius}</radius>
              <length>${wheel_width}</length>
            </cylinder>
          </geometry>
          <surface><friction><ode>
            <fdir1>1 0 0</fdir1>
            <mu>3.0</mu>
            <mu2>3.0</mu2>
          </ode></friction></surface>
        </collision>

        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </link>
    </xacro:macro>

    <xacro:wheel prefix="drivewhl_l" x_reflect="-1" y_reflect="1" />
    <xacro:wheel prefix="drivewhl_r" x_reflect="-1" y_reflect="-1" />

    <!-- Caster Wheels -->
    <xacro:macro name="caster_wheel" params="prefix x_reflect y_reflect">
      <joint name="${prefix}_joint" type="fixed">
        <parent>base_link</parent>
        <child>${prefix}_link</child>
        <pose relative_to="base_link">${x_reflect*caster_xoff} ${y_reflect*(base_width/2+caster_yoff)} ${-caster_zoff} 0 0 0</pose>
      </joint>

      <link name="${prefix}_link">
        <pose relative_to="${prefix}_joint"/>
        <visual name="${prefix}_link_visual">
          <pose relative_to="${prefix}_link">0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>file://${XACRO_DIR}/meshes/caster.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
          </material>
        </visual>

        <collision name="${prefix}_link_collision">
          <pose relative_to="${prefix}_link">0 0 0 ${pi/2} 0 0</pose>
          <geometry>
            <!-- <cylinder>
              <radius>${caster_radius}</radius>
              <length>${caster_width}</length>
            </cylinder> -->
            <sphere> 
              <radius>${caster_radius}</radius>
            </sphere>
          </geometry>
          <surface><friction><ode>
            <fdir1>1 0 0</fdir1>   <!-- μ along X (rolling), μ₂ along Y (slip) -->
            <mu>0.01</mu>          <!-- low rolling resistance (free spin) -->
            <mu2>0.01</mu2> 
          </ode></friction></surface>          
        </collision>

        <xacro:cylinder_inertia m="${caster_mass}" r="${caster_radius}" h="${caster_width}"/>        
      </link>
    </xacro:macro>

    <xacro:caster_wheel prefix="casterwhl_fl" x_reflect="1" y_reflect="1" />
    <xacro:caster_wheel prefix="casterwhl_fr" x_reflect="1" y_reflect="-1" />
    <xacro:caster_wheel prefix="casterwhl_rl" x_reflect="-1" y_reflect="1" />
    <xacro:caster_wheel prefix="casterwhl_rr" x_reflect="-1" y_reflect="-1" />

    <joint name='imu_joint' type='fixed'>
      <parent>base_link</parent>
      <child>imu_link</child>
      <pose relative_to="base_link">0.0 0.0 0.01 0 0 0</pose>
    </joint>

    <link name='imu_link'>
      <pose relative_to="imu_joint"/>
      <visual name="imu_link_visual">
        <geometry>
          <box><size>
            0.1 0.1 0.1
          </size></box>
        </geometry>
      </visual>

      <collision name="imu_link_collision">
        <geometry>
          <box><size>
            0.1 0.1 0.1
          </size></box>
        </geometry>
      </collision>

      <xacro:box_inertia m="0.1" w="0.1" l="0.1" h="0.1"/>

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>    

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <!-- Ground-truth odometry: pose sebenarnya robot dari Gazebo (tanpa slip /
         SLAM drift). Origin = posisi spawn. Untuk validasi tracking SMC. -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>ground_truth_odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/model/polebot_amr/odometry</odom_topic>
      <tf_topic>/model/polebot_amr/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
      <pose relative_to="base_link">${lidar_xoff} 0.0 ${lidar_zoff} 0 0 0</pose>
    </joint>

    <link name='lidar_link'>
      <pose relative_to="lidar_joint"/>
      <visual name="lidar_link_visual">
        <geometry>
          <mesh>
            <uri>file://${XACRO_DIR}/meshes/lidar.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="lidar_link_collision">
        <geometry>
          <cylinder>
            <radius>0.0208</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
      </collision>

      <xacro:cylinder_inertia m="0.125" r="0.0208" h="0.055"/>

      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>5.0</update_rate>
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>270</samples>
              <resolution>1.000000</resolution>
              <min_angle>-2.093</min_angle>
              <max_angle>2.093</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>25.0</max>
            <resolution>0.015000</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">${camera_xoff} 0.0 ${camera_zoff} 0 0 0</pose>
    </joint>

    <link name='camera_link'>
      <pose relative_to="camera_joint"/>
      <visual name="camera_link_visual">
        <geometry>
          <mesh>
            <uri>file://${XACRO_DIR}/meshes/camera.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="camera_link_collision">
        <geometry>
          <box><size>
            0.015 0.130 0.0222
          </size></box>
        </geometry>
      </collision>

      <xacro:box_inertia m="0.123" w="0.015" l="0.130" h="0.0222"/>
      
      <sensor name="depth_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>5.0</update_rate>
        <topic>depth_camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.047198</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>3.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- Mode aktuasi robot — bisa dipilih, TIDAK boleh dua-duanya aktif
         bersamaan (akan rebutan mengontrol roda yang sama):
           - "diffdrive"      : plugin native Gazebo, dipakai motion control
                                 pure-pursuit/PID yang sudah ada (publish /cmd_vel).
           - "effort_control" : ros2_control + gz_ros2_control, dipakai
                                 controller SMC/path-planning point-cloud baru
                                 (publish torsi ke /joint_group_effort_controller/commands).
         Default tetap "diffdrive" supaya launch file lama tidak berubah sama sekali. -->
    <xacro:arg name="actuation_mode" default="diffdrive"/>
    <xacro:property name="actuation_mode_val" value="$(arg actuation_mode)"/>

    <xacro:if value="${actuation_mode_val == 'diffdrive'}">
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- wheels -->
      <left_joint>drivewhl_l_joint</left_joint>
      <right_joint>drivewhl_r_joint</right_joint>

      <!-- kinematics -->
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <!-- limits -->
      <max_linear_acceleration>2.0</max_linear_acceleration>

      <!-- input -->
      <topic>/cmd_vel</topic>

      <!-- output -->
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
    </xacro:if>

    <xacro:if value="${actuation_mode_val == 'effort_control'}">
    <ros2_control name="polebot_diff_drive" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="drivewhl_l_joint">
        <command_interface name="effort">
          <param name="min">-50</param>
          <param name="max">50</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="drivewhl_r_joint">
        <command_interface name="effort">
          <param name="min">-50</param>
          <param name="max">50</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <xacro:arg name="controllers_yaml" default=""/>
    <xacro:property name="controllers_yaml_val" value="$(arg controllers_yaml)"/>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>${controllers_yaml_val}</parameters>
    </plugin>
    </xacro:if>

    <!-- NOTE controllers_yaml: xacro TIDAK bisa mensubstitusi "$(arg ...)" (itu
         sintaks launch ROS2). Path controllers.yaml WAJIB dikirim lewat parameter
         `mappings={'controllers_yaml': <path_absolut>}` saat xacro.process_file()
         dipanggil dari launch file Python, seperti pada sim_path_planning_smc.launch.py. -->


    <!-- Hitch point at rear of robot for trolley attachment -->
    <joint name='hitch_joint' type='fixed'>
      <parent>base_link</parent>
      <child>hitch_link</child>
      <pose relative_to="base_link">${-(base_length/2)} 0 0 0 0 0</pose>
    </joint>
    <link name='hitch_link'>
      <pose relative_to="hitch_joint"/>
      <!-- Tongkat pengait visual HANYA untuk mode pivot (revolute). Mode fixed langsung menempel tanpa tongkat pengait. -->
      <xacro:if value="${hitch_type_val == 'revolute'}">
        <!-- Visual tongkat pengait 0.300m (0.050m masuk robot, 0.200m di udara, 0.050m masuk trolley) -->
        <visual name='tongkat_pengait_visual'>
          <pose>-0.100 0 -0.05375 0 1.226 0</pose>
          <geometry>
            <cylinder>
              <radius>0.018</radius>
              <length>0.319</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1.0</ambient>
            <diffuse>0.3 0.3 0.3 1.0</diffuse>
            <specular>0.6 0.6 0.6 1.0</specular>
          </material>
        </visual>
        <!-- Pin pengait di depan tengah trolley (x=-0.200 dari hitch_link robot) -->
        <visual name='tongkat_pin_visual'>
          <pose>-0.200 0 -0.1075 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.070</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
      </xacro:if>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>

    <!-- DetachableJoint: disabled for debugging
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>hitch_link</parent_link>
      <child_model>trolley</child_model>
      <child_link>trolley_base_link</child_link>
      <topic>/polebot_amr/attach_trolley</topic>
    </plugin>
    -->

    <!-- include_trolley=false → RSP gets clean robot-only description -->
    <xacro:arg name="include_trolley" default="true"/>

    <!-- ============================================================
         NESTED TROLLEY MODEL
         Pose in robot frame: hitch_link at x=-0.586 from base_link
         Tongkat pengait: x=-0.200 from hitch_link (0.200m di udara, 0.050m masuk robot, 0.050m masuk trolley)
         So trolley_base_link sits at x = -0.586 - 0.200 = -0.786 from base_link
         ============================================================ -->

    <!-- Trolley properties (prefixed tr_ to avoid conflict with robot macros) -->
    <xacro:property name="tr_XACRO_DIR" value="${xacro.abs_filename('')}"/>
    <xacro:property name="tr_base_mass" value="5.000"/>
    <xacro:property name="tr_base_width" value="1.000"/>
    <xacro:property name="tr_base_length" value="1.300"/>
    <xacro:property name="tr_base_height" value="0.040"/>

    <xacro:property name="tr_pallet_mass" value="5.000"/>
    <xacro:property name="tr_pallet_width" value="1.000"/>
    <xacro:property name="tr_pallet_length" value="1.300"/>
    <xacro:property name="tr_pallet_height" value="0.100"/>
    <xacro:property name="tr_pallet_zoff" value="0.070"/>

    <xacro:property name="tr_wheel_mass" value="0.5"/>
    <xacro:property name="tr_wheel_radius" value="0.0725"/>
    <xacro:property name="tr_wheel_width" value="0.055"/>
    <xacro:property name="tr_wheel_xoff" value="0.495"/>
    <xacro:property name="tr_wheel_yoff" value="0.455"/>
    <xacro:property name="tr_wheel_zoff" value="0.130"/>

    <xacro:property name="tr_caster_mass" value="0.5"/>
    <xacro:property name="tr_caster_radius" value="0.0675"/>
    <xacro:property name="tr_caster_width" value="0.055"/>
    <xacro:property name="tr_caster_xoff" value="0.555"/>
    <xacro:property name="tr_caster_yoff" value="0.400"/>
    <xacro:property name="tr_caster_zoff" value="0.135"/>


    <!-- Trolley inertia macros (prefixed tr_ to avoid conflict) -->
    <xacro:macro name="tr_box_inertia" params="m w l h">
      <inertial>
        <pose>0 0 0 ${pi/2} 0 ${pi/2}</pose>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(m/12) * (l*l + h*h)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(m/12) * (w*w + h*h)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(m/12) * (w*w + l*l)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>

    <xacro:macro name="tr_cylinder_inertia" params="m r h">
      <inertial>
        <pose>0 0 0 ${pi/2} 0 0</pose>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(m/12) * (3*r*r + h*h)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(m/12) * (3*r*r + h*h)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(m/2) * (r*r)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>

    <xacro:if value="$(arg include_trolley)">

    <!-- ============================================================
         A. MODEL TROLLEY PIVOT JOINT (hitch_type == 'revolute')
         - Tongkat pengait 0.300m (0.200m di udara, 0.050m masuk robot, 0.050m masuk trolley)
         - Titik pivot tunggal di lubang depan tengah trolley (x = -0.200 dari hitch_link)
         - trolley_base_link berpusat di lubang pivot depan tengah
         - Roda belakang pasif berputar (revolute, anti-skid mu2=20.0)
         - Caster depan berbentuk bola licin (sphere, mu=0.01)
         ============================================================ -->
    <xacro:if value="${hitch_type_val == 'revolute'}">

      <!-- Trolley wheel macro (passive revolute wheel, spins when trailer rolls) -->
      <xacro:macro name="tr_wheel_pivot" params="prefix x_reflect y_reflect">
        <joint name="${prefix}_joint" type="revolute">
          <parent>trolley_base_link</parent>
          <child>${prefix}_link</child>
          <pose relative_to="trolley_base_link">${-(tr_base_length/2) + x_reflect*tr_wheel_xoff} ${y_reflect*tr_wheel_yoff} ${-tr_wheel_zoff} 0 0 0</pose>
          <axis>
            <xyz>0 1 0</xyz>
            <limit>
              <lower>-inf</lower>
              <upper>inf</upper>
            </limit>
            <dynamics>
              <damping>0.005</damping>
              <friction>0.001</friction>
            </dynamics>
          </axis>
        </joint>
        <link name="${prefix}_link">
          <pose relative_to="${prefix}_joint"/>
          <visual name="${prefix}_link_visual">
            <pose relative_to="${prefix}_link">0 0 0 0 0 ${(y_reflect-1)*pi/2}</pose>
            <geometry>
              <mesh>
                <uri>file://${tr_XACRO_DIR}/meshes/trolley_wheel.stl</uri>
                <scale>0.001 0.001 0.001</scale>
              </mesh>
            </geometry>
            <material>
              <ambient>0.3 0.3 0.3 1.0</ambient>
              <diffuse>0.7 0.7 0.7 1.0</diffuse>
            </material>
          </visual>
          <collision name="${prefix}_link_collision">
            <pose relative_to="${prefix}_link">0 0 0 ${pi/2} 0 0</pose>
            <geometry>
              <cylinder>
                <radius>${tr_wheel_radius}</radius>
                <length>${tr_wheel_width}</length>
              </cylinder>
            </geometry>
            <surface><friction><ode>
              <fdir1>1 0 0</fdir1>
              <mu>1.0</mu>
              <mu2>2.5</mu2>   <!-- Grip lateral terkalibrasi: stabil saat lurus, menyapu alami saat berbelok tanpa menahan kemudi robot -->
            </ode></friction></surface>
          </collision>
          <xacro:tr_cylinder_inertia m="${tr_wheel_mass}" r="${tr_wheel_radius}" h="${tr_wheel_width}"/>
        </link>
      </xacro:macro>

      <!-- Trolley caster wheel macro -->
      <xacro:macro name="tr_caster_wheel_pivot" params="prefix x_reflect y_reflect">
        <link name="${prefix}_link">
          <pose relative_to="${prefix}_joint"/>
          <visual name="${prefix}_link_visual">
            <geometry>
              <mesh>
                <uri>file://${tr_XACRO_DIR}/meshes/trolley_caster.stl</uri>
                <scale>0.001 0.001 0.001</scale>
              </mesh>
            </geometry>
            <material>
              <ambient>0.3 0.3 0.3 1.0</ambient>
              <diffuse>0.7 0.7 0.7 1.0</diffuse>
            </material>
          </visual>
          <collision name="${prefix}_link_collision">
            <pose relative_to="${prefix}_link">0 0 0 ${pi/2} 0 0</pose>
            <geometry>
              <sphere>
                <radius>${tr_caster_radius}</radius>
              </sphere>
            </geometry>
            <surface><friction><ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode></friction></surface>
          </collision>
          <xacro:tr_cylinder_inertia m="${tr_caster_mass}" r="${tr_caster_radius}" h="${tr_caster_width}"/>
        </link>
        <joint name="${prefix}_joint" type="fixed">
          <parent>trolley_base_link</parent>
          <child>${prefix}_link</child>
          <pose relative_to="trolley_base_link">${-(tr_base_length/2) + x_reflect*tr_caster_xoff} ${y_reflect*tr_caster_yoff} ${-tr_caster_zoff} 0 0 0</pose>
        </joint>
      </xacro:macro>

      <!-- Hitch joint: revolute (Pivot tunggal di satu titik lubang tengah, trailer steers passively) -->
      <joint name='trolley_hitch_joint' type='revolute'>
        <parent>hitch_link</parent>
        <child>trolley_base_link</child>
        <pose relative_to="hitch_link">-0.200 0 -0.1075 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.57</lower>
            <upper>1.57</upper>
          </limit>
          <dynamics>
            <damping>0.02</damping>
            <friction>0.0</friction>
          </dynamics>
        </axis>
      </joint>

      <!-- Trolley Base (Origin at front-center pivot hole) -->
      <link name='trolley_base_link'>
        <pose relative_to="trolley_hitch_joint"/>
        <!-- Visual lubang pivot di depan tengah trolley -->
        <visual name="trolley_pivot_hole_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.050</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1.0</ambient>
            <diffuse>0.25 0.25 0.25 1.0</diffuse>
          </material>
        </visual>
        <visual name="trolley_base_link_visual">
          <pose>-${tr_base_length/2} 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>file://${tr_XACRO_DIR}/meshes/trolley_frame.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0 0.4 0.5 1</ambient>
            <diffuse>0 0.4 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="trolley_base_link_collision">
          <pose>-${tr_base_length/2} 0 0 0 0 0</pose>
          <geometry>
            <box><size>
              ${tr_base_length} ${tr_base_width} ${tr_base_height}
            </size></box>
          </geometry>
          <surface><friction><ode>
            <mu>0.0001</mu>
            <mu2>0.0001</mu2>
          </ode></friction></surface>
        </collision>
        <inertial>
          <pose>-${tr_base_length/2} 0 0 ${pi/2} 0 ${pi/2}</pose>
          <mass>${tr_base_mass}</mass>
          <inertia>
            <ixx>${(tr_base_mass/12) * (tr_base_length*tr_base_length + tr_base_height*tr_base_height)}</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>${(tr_base_mass/12) * (tr_base_width*tr_base_width + tr_base_height*tr_base_height)}</iyy>
            <iyz>0.0</iyz>
            <izz>${(tr_base_mass/12) * (tr_base_width*tr_base_width + tr_base_length*tr_base_length)}</izz>
          </inertia>
        </inertial>
      </link>

      <!-- Trolley Footprint (Origin at front-center, ground projection) -->
      <link name='trolley_base_footprint'>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.001</mass>
          <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <joint name='tr_base_joint' type='fixed'>
        <parent>trolley_base_link</parent>
        <child>trolley_base_footprint</child>
        <pose relative_to="trolley_base_link">0.0 0.0 ${-(tr_wheel_radius+tr_wheel_zoff)} 0 0 0</pose>
      </joint>

      <!-- Pallet (Origin coincident with front-center, mesh placed over frame) -->
      <link name='pallet_link'>
        <pose relative_to="pallet_joint"/>
        <visual name="pallet_link_visual">
          <pose>-${tr_base_length/2} 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>file://${tr_XACRO_DIR}/meshes/trolley_pallet.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="pallet_link_collision">
          <pose>-${tr_base_length/2} 0 0 0 0 0</pose>
          <geometry>
            <box><size>
              ${tr_pallet_length} ${tr_pallet_width} ${tr_pallet_height}
            </size></box>
          </geometry>
        </collision>
        <inertial>
          <pose>-${tr_base_length/2} 0 0 ${pi/2} 0 ${pi/2}</pose>
          <mass>${tr_pallet_mass}</mass>
          <inertia>
            <ixx>${(tr_pallet_mass/12) * (tr_pallet_length*tr_pallet_length + tr_pallet_height*tr_pallet_height)}</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>${(tr_pallet_mass/12) * (tr_pallet_width*tr_pallet_width + tr_pallet_height*tr_pallet_height)}</iyy>
            <iyz>0.0</iyz>
            <izz>${(tr_pallet_mass/12) * (tr_pallet_width*tr_pallet_width + tr_pallet_length*tr_pallet_length)}</izz>
          </inertia>
        </inertial>
      </link>
      <joint name='pallet_joint' type='fixed'>
        <parent>trolley_base_link</parent>
        <child>pallet_link</child>
        <pose relative_to="trolley_base_link">0 0 ${tr_pallet_zoff} 0 0 0</pose>
      </joint>

      <!-- Passive rear wheels (roda belakang pasif / trailing unactuated, digerakkan murni oleh traksi fisik saat ditarik) -->
      <xacro:tr_wheel_pivot prefix="trolley_wheel_l" x_reflect="-1" y_reflect="1" />
      <xacro:tr_wheel_pivot prefix="trolley_wheel_r" x_reflect="-1" y_reflect="-1" />

      <!-- Caster wheels -->
      <xacro:tr_caster_wheel_pivot prefix="trolley_caster_l" x_reflect="1" y_reflect="1" />
      <xacro:tr_caster_wheel_pivot prefix="trolley_caster_r" x_reflect="1" y_reflect="-1" />

    </xacro:if>

    <!-- ============================================================
         B. MODEL TROLLEY FIXED JOINT (hitch_type == 'fixed' / model lama)
         - Menempel langsung ke belakang robot tanpa tongkat pengait (x = -0.650)
         - trolley_base_link berpusat di tengah badan trolley (0 0 0)
         - Sendi roda dan caster bertipe fixed (model lama)
         ============================================================ -->
    <xacro:unless value="${hitch_type_val == 'revolute'}">

      <!-- Trolley wheel macro (model lama: fixed joint) -->
      <xacro:macro name="tr_wheel_fixed" params="prefix x_reflect y_reflect">
        <link name="${prefix}_link">
          <pose relative_to="${prefix}_joint"/>
          <visual name="${prefix}_link_visual">
            <pose relative_to="${prefix}_link">0 0 0 0 0 ${(y_reflect-1)*pi/2}</pose>
            <geometry>
              <mesh>
                <uri>file://${tr_XACRO_DIR}/meshes/trolley_wheel.stl</uri>
                <scale>0.001 0.001 0.001</scale>
              </mesh>
            </geometry>
            <material>
              <ambient>0.3 0.3 0.3 1.0</ambient>
              <diffuse>0.7 0.7 0.7 1.0</diffuse>
            </material>
          </visual>
          <collision name="${prefix}_link_collision">
            <pose relative_to="${prefix}_link">0 0 0 ${pi/2} 0 0</pose>
            <geometry>
              <cylinder>
                <radius>${tr_wheel_radius}</radius>
                <length>${tr_wheel_width}</length>
              </cylinder>
            </geometry>
            <surface><friction><ode>
              <fdir1>1 0 0</fdir1>
              <mu>0.01</mu>
              <mu2>3.5</mu2>   <!-- grip lateral dinaikkan: trailer meluruskan diri (anti over-bend) -->
            </ode></friction></surface>
          </collision>
          <xacro:tr_cylinder_inertia m="${tr_wheel_mass}" r="${tr_wheel_radius}" h="${tr_wheel_width}"/>
        </link>
        <joint name="${prefix}_joint" type="fixed">
          <parent>trolley_base_link</parent>
          <child>${prefix}_link</child>
          <pose relative_to="trolley_base_link">${x_reflect*tr_wheel_xoff} ${y_reflect*tr_wheel_yoff} ${-tr_wheel_zoff} 0 0 0</pose>
        </joint>
      </xacro:macro>

      <!-- Trolley caster wheel macro (model lama: fixed joint, cylinder collision) -->
      <xacro:macro name="tr_caster_wheel_fixed" params="prefix x_reflect y_reflect">
        <link name="${prefix}_link">
          <pose relative_to="${prefix}_joint"/>
          <visual name="${prefix}_link_visual">
            <geometry>
              <mesh>
                <uri>file://${tr_XACRO_DIR}/meshes/trolley_caster.stl</uri>
                <scale>0.001 0.001 0.001</scale>
              </mesh>
            </geometry>
            <material>
              <ambient>0.3 0.3 0.3 1.0</ambient>
              <diffuse>0.7 0.7 0.7 1.0</diffuse>
            </material>
          </visual>
          <collision name="${prefix}_link_collision">
            <pose relative_to="${prefix}_link">0 0 0 ${pi/2} 0 0</pose>
            <geometry>
              <cylinder>
                <radius>${tr_caster_radius}</radius>
                <length>${tr_caster_width}</length>
              </cylinder>
            </geometry>
            <surface><friction><ode>
              <mu>0.0001</mu>
              <mu2>0.0001</mu2>
            </ode></friction></surface>
          </collision>
          <xacro:tr_cylinder_inertia m="${tr_caster_mass}" r="${tr_caster_radius}" h="${tr_caster_width}"/>
        </link>
        <joint name="${prefix}_joint" type="fixed">
          <parent>trolley_base_link</parent>
          <child>${prefix}_link</child>
          <pose relative_to="trolley_base_link">${x_reflect*tr_caster_xoff} ${y_reflect*tr_caster_yoff} ${-tr_caster_zoff} 0 0 0</pose>
        </joint>
      </xacro:macro>

      <!-- Hitch joint (model lama: fixed joint, pose x = -0.650) -->
      <joint name='trolley_hitch_joint' type='fixed'>
        <parent>hitch_link</parent>
        <child>trolley_base_link</child>
        <pose relative_to="hitch_link">-0.650 0 -0.1075 0 0 0</pose>
      </joint>

      <!-- Trolley Base (model lama: origin di tengah badan trolley) -->
      <link name='trolley_base_link'>
        <pose relative_to="trolley_hitch_joint"/>
        <visual name="trolley_base_link_visual">
          <geometry>
            <mesh>
              <uri>file://${tr_XACRO_DIR}/meshes/trolley_frame.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0 0.4 0.5 1</ambient>
            <diffuse>0 0.4 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="trolley_base_link_collision">
          <geometry>
            <box><size>
              ${tr_base_length} ${tr_base_width} ${tr_base_height}
            </size></box>
          </geometry>
          <surface><friction><ode>
            <mu>0.0001</mu>
            <mu2>0.0001</mu2>
          </ode></friction></surface>
        </collision>
        <xacro:tr_box_inertia m="${tr_base_mass}" w="${tr_base_width}" l="${tr_base_length}" h="${tr_base_height}"/>
      </link>

      <!-- Trolley Footprint (model lama) -->
      <link name='trolley_base_footprint'>
        <xacro:tr_box_inertia m="${tr_base_mass}" w="${tr_base_width}" l="${tr_base_length}" h="${tr_base_height}"/>
      </link>
      <joint name='tr_base_joint' type='fixed'>
        <parent>trolley_base_link</parent>
        <child>trolley_base_footprint</child>
        <pose relative_to="trolley_base_link">0.0 0.0 ${-(tr_wheel_radius+tr_wheel_zoff)} 0 0 0</pose>
      </joint>

      <!-- Pallet (model lama) -->
      <link name='pallet_link'>
        <pose relative_to="pallet_joint"/>
        <visual name="pallet_link_visual">
          <geometry>
            <mesh>
              <uri>file://${tr_XACRO_DIR}/meshes/trolley_pallet.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="pallet_link_collision">
          <geometry>
            <box><size>
              ${tr_pallet_length} ${tr_pallet_width} ${tr_pallet_height}
            </size></box>
          </geometry>
        </collision>
        <xacro:tr_box_inertia m="${tr_pallet_mass}" w="${tr_pallet_width}" l="${tr_pallet_length}" h="${tr_pallet_height}"/>
      </link>
      <joint name='pallet_joint' type='fixed'>
        <parent>trolley_base_link</parent>
        <child>pallet_link</child>
        <pose relative_to="trolley_base_link">0 0 ${tr_pallet_zoff} 0 0 0</pose>
      </joint>

      <!-- Drive wheels (model lama) -->
      <xacro:tr_wheel_fixed prefix="trolley_wheel_l" x_reflect="-1" y_reflect="1" />
      <xacro:tr_wheel_fixed prefix="trolley_wheel_r" x_reflect="-1" y_reflect="-1" />

      <!-- Caster wheels (model lama) -->
      <xacro:tr_caster_wheel_fixed prefix="trolley_caster_l" x_reflect="1" y_reflect="1" />
      <xacro:tr_caster_wheel_fixed prefix="trolley_caster_r" x_reflect="1" y_reflect="-1" />

    </xacro:unless>

    </xacro:if>

  </model>
</sdf>