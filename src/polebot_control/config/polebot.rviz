Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: odom

    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Topic:
        Value: /robot_description

    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Axes: true
      Show Arrows: false
      Show Names: false

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Reference Path
      Topic:
        Value: /reference_path
      Color: 0; 255; 0
      Alpha: 1
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.10
      Offset:
        X: 0
        Y: 0
        Z: 0.03

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Actual Path
      Topic:
        Value: /actual_path
      Color: 255; 0; 0
      Alpha: 1
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.10
      Offset:
        X: 0
        Y: 0
        Z: 0.06

  Enabled: true
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Name: root

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.8
      Near Clip Distance: 0.01
      Target Frame: odom

Window Geometry:
  Height: 900
  Width: 1400