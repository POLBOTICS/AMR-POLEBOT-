<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="polebot">

  <!-- ======================================================== -->
  <!--  POLEBOT — AMR Differential Drive Robot                  -->
  <!--  Politeknik Manufaktur Bandung                           -->
  <!-- ======================================================== -->

  <xacro:include filename="$(find polebot_description)/urdf/materials.xacro"/>

  <!-- =================== ROBOT PARAMETERS =================== -->
  <!-- Base dimensions (from CAD) -->
  <xacro:property name="base_length"   value="1.172"/>
  <xacro:property name="base_width"    value="0.670"/>
  <xacro:property name="base_height"   value="0.563"/>
  <xacro:property name="base_mass"     value="84.837"/>

  <!-- Wheel parameters -->
  <xacro:property name="wheel_radius"  value="0.079"/>
  <xacro:property name="wheel_width"   value="0.055"/>
  <xacro:property name="wheel_mass"    value="3.610"/>
  <xacro:property name="wheel_separation" value="0.600"/>
  <xacro:property name="wheel_zoff"    value="0.231"/>

  <!-- Caster parameters -->
  <xacro:property name="caster_radius" value="0.0625"/>
  <xacro:property name="caster_width"  value="0.0520"/>
  <xacro:property name="caster_mass"   value="1.355"/>
  <xacro:property name="caster_xoff"   value="0.300"/>
  <xacro:property name="caster_yoff"   value="0.0289"/>
  <xacro:property name="caster_zoff"   value="0.245"/>

  <!-- Sensor parameters -->
  <xacro:property name="lidar_xoff"    value="0.496"/>
  <xacro:property name="lidar_zoff"    value="0.040"/>
  <xacro:property name="camera_xoff"   value="0.560"/>
  <xacro:property name="camera_zoff"   value="-0.023"/>
  
  <xacro:property name="monitor_xoff"  value="0.204"/>
  <xacro:property name="monitor_zoff"  value="0.730"/>

  <!-- =================== BASE FOOTPRINT ====================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + wheel_zoff}" rpy="0 0 0"/>
  </joint>

  <!-- =================== BASE LINK ========================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://polebot_description/meshes/polebot_amr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height/2}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${(1/12)*base_mass*(base_width**2 + base_height**2)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*base_mass*(base_length**2 + base_height**2)}"
        iyz="0"
        izz="${(1/12)*base_mass*(base_length**2 + base_width**2)}"/>
    </inertial>
  </link>

  <!-- =================== MONITOR ============================ -->
  <link name="monitor_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://polebot_description/meshes/monitor.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.9"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="16.008"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="monitor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="monitor_link"/>
    <origin xyz="${monitor_xoff} 0 ${monitor_zoff}" rpy="0 0 0"/>
  </joint>

  <!-- =================== WHEELS MACRO ======================= -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${(y_reflect-1)*pi/2}"/>
        <geometry>
          <mesh filename="package://polebot_description/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${(1/12)*wheel_mass*(3*wheel_radius**2 + wheel_width**2)}"
          ixy="0" ixz="0"
          iyy="${(1/2)*wheel_mass*wheel_radius**2}"
          iyz="0"
          izz="${(1/12)*wheel_mass*(3*wheel_radius**2 + wheel_width**2)}"/>
      </inertial>
    </link>

    <joint name="${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_link"/>
      <origin xyz="0 ${y_reflect * wheel_separation/2} ${-wheel_zoff}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="drivewhl_l" y_reflect="1"/>
  <xacro:drive_wheel prefix="drivewhl_r" y_reflect="-1"/>

  <!-- =================== CASTER MACRO ======================= -->
  <xacro:macro name="caster_wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://polebot_description/meshes/caster.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${caster_mass}"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${prefix}_link"/>
      <origin xyz="${x_reflect * caster_xoff} ${y_reflect * (base_width/2 + caster_yoff)} ${-caster_zoff}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster_wheel prefix="casterwhl_fl" x_reflect="1" y_reflect="1"/>
  <xacro:caster_wheel prefix="casterwhl_fr" x_reflect="1" y_reflect="-1"/>
  <xacro:caster_wheel prefix="casterwhl_rl" x_reflect="-1" y_reflect="1"/>
  <xacro:caster_wheel prefix="casterwhl_rr" x_reflect="-1" y_reflect="-1"/>

  <!-- =================== SENSORS ============================ -->
  <!-- LiDAR frame -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://polebot_description/meshes/lidar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0208" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.125"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="${lidar_xoff} 0 ${lidar_zoff}" rpy="0 0 0"/>
  </joint>

  <!-- IMU frame -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0.1 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Camera frame -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://polebot_description/meshes/camera.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.130 0.0222"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.123"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${camera_xoff} 0 ${camera_zoff}" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

</robot>
