<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="polebot">

  <!-- ======================================================== -->
  <!--  POLEBOT — AMR Differential Drive Robot                  -->
  <!--  Politeknik Manufaktur Bandung                           -->
  <!-- ======================================================== -->

  <!-- Include sub-components -->
  <xacro:include filename="$(find polebot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find polebot_description)/urdf/polebot_base.xacro"/>
  <xacro:include filename="$(find polebot_description)/urdf/polebot_wheels.xacro"/>
  <xacro:include filename="$(find polebot_description)/urdf/polebot_sensors.xacro"/>

  <!-- =================== ROBOT PARAMETERS =================== -->
  <!-- Base dimensions -->
  <xacro:property name="base_length"   value="0.45"/>   <!-- meters -->
  <xacro:property name="base_width"    value="0.35"/>
  <xacro:property name="base_height"   value="0.15"/>
  <xacro:property name="base_mass"     value="8.0"/>    <!-- kg -->

  <!-- Wheel parameters -->
  <xacro:property name="wheel_radius"  value="0.065"/>
  <xacro:property name="wheel_width"   value="0.04"/>
  <xacro:property name="wheel_mass"    value="0.5"/>
  <xacro:property name="wheel_separation" value="0.35"/>

  <!-- Caster parameters -->
  <xacro:property name="caster_radius" value="0.02"/>

  <!-- =================== BASE FOOTPRINT ====================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- =================== BASE LINK ========================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${(1/12)*base_mass*(base_width**2 + base_height**2)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*base_mass*(base_length**2 + base_height**2)}"
        iyz="0"
        izz="${(1/12)*base_mass*(base_length**2 + base_width**2)}"/>
    </inertial>
  </link>

  <!-- =================== WHEELS ============================= -->
  <!-- Left drive wheel -->
  <link name="left_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1/12)*wheel_mass*(3*wheel_radius**2 + wheel_width**2)}"
        ixy="0" ixz="0"
        iyy="${(1/2)*wheel_mass*wheel_radius**2}"
        iyz="0"
        izz="${(1/12)*wheel_mass*(3*wheel_radius**2 + wheel_width**2)}"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="left_wheel_link"/>
    <origin xyz="0 ${wheel_separation/2} 0" rpy="${-pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Right drive wheel -->
  <link name="right_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1/12)*wheel_mass*(3*wheel_radius**2 + wheel_width**2)}"
        ixy="0" ixz="0"
        iyy="${(1/2)*wheel_mass*wheel_radius**2}"
        iyz="0"
        izz="${(1/12)*wheel_mass*(3*wheel_radius**2 + wheel_width**2)}"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="right_wheel_link"/>
    <origin xyz="0 ${-wheel_separation/2} 0" rpy="${-pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Front caster -->
  <link name="front_caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="front_caster_link"/>
    <origin xyz="${base_length/2 - caster_radius} 0 ${-base_height/2 + caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Rear caster -->
  <link name="rear_caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rear_caster_link"/>
    <origin xyz="${-(base_length/2 - caster_radius)} 0 ${-base_height/2 + caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- =================== SENSORS ============================ -->
  <!-- LiDAR frame -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.045"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="${base_length/4} 0 ${base_height/2 + 0.025}" rpy="0 0 0"/>
  </joint>

  <!-- IMU frame -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Camera frame -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${base_length/2} 0 ${base_height/4}" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

</robot>
